<!-- =======================
  ✅ SIDEBAR GOLD (NEGRO + GOLD)
  - CDN abre /cdn (PÁGINA)
  - PAYLOAD abre /payloads (PÁGINA)
  - NOTAS abre MODAL
  - ACCESO abre /
  - Links normales: misma pestaña
  - Sidebar debajo del header (top + z-index)
======================= -->

<div class="sidebar shadow kv-gold" id="sidebar">
  <div class="kv-goldfx" aria-hidden="true"></div>

  <!-- Header interno ultra compacto -->
  <div class="sidebar-header">
    <a href="javascript:void(0)" class="menu-text" aria-label="Inicio">
      <span class="menu-hidden">MENU</span>
    </a>
  </div>

  <ul class="sidebar-nav">
    <li class="nav-item tools-item" id="toolsItem">
      <a href="#" class="nav-link active" id="toolsToggle" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <path d="M14.7 6.3a4.5 4.5 0 0 0-6.4 6.4l-5.1 5.1a1 1 0 0 0 0 1.4l1 1a1 1 0 0 0 1.4 0l5.1-5.1a4.5 4.5 0 0 0 6.4-6.4z"/>
          <path d="M15.5 5.5l3-3 3 3-3 3z"/>
        </svg>
        <span>HERRAMIENTAS</span>
        <span class="tools-caret" aria-hidden="true">▾</span>
      </a>

      <div class="tools-panel" id="toolsPanel" aria-hidden="true">
        <div class="tools-card">
          <div class="tools-grid">
            <!-- ✅ CDN abre /cdn -->
            <button type="button" class="tool-btn" id="toolCdn"><i class="bi bi-cloud"></i> CDN</button>

            <!-- ✅ ACCESO abre HOME -->
            <button type="button" class="tool-btn" id="toolAcceso"><i class="bi bi-shield-lock"></i> ACCESO</button>

            <!-- ✅ PAYLOAD abre /payloads -->
            <button type="button" class="tool-btn" id="toolPayload"><i class="bi bi-code-slash"></i> PAYLOAD</button>

            <!-- ✅ NOTAS abre MODAL -->
            <button type="button" class="tool-btn" id="toolNotas"><i class="bi bi-journal-text"></i> NOTAS</button>
          </div>
        </div>
      </div>
    </li>

    <li class="nav-item">
      <a href="/categories" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        <span>CATEGORIAS</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/configs" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <circle cx="12" cy="12" r="4"/>
          <line x1="12" y1="2" x2="12" y2="6"/>
          <line x1="12" y1="18" x2="12" y2="22"/>
          <line x1="2" y1="12" x2="6" y2="12"/>
          <line x1="18" y1="12" x2="22" y2="12"/>
        </svg>
        <span>SERVIDORES</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/application" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <rect x="7" y="2" width="10" height="20" rx="2"/>
          <circle cx="12" cy="18" r="1"/>
        </svg>
        <span>APP & TEMAS</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/texts" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <line x1="4" y1="6" x2="20" y2="6"/>
          <line x1="4" y1="12" x2="16" y2="12"/>
          <line x1="4" y1="18" x2="18" y2="18"/>
        </svg>
        <span>TEXTOS</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/notifications" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2z"/>
          <path d="M18 16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5S10.5 3.17 10.5 4v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
        </svg>
        <span>NOTIFICACIONES</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/profile" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21c0-4 4-7 8-7s8 3 8 7"/>
        </svg>
        <span>PERFIL</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/logout" class="nav-link danger">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <line x1="21" y1="12" x2="9" y2="12"/>
          <polyline points="16 17 21 12 16 7"/>
        </svg>
        <span>SALIR</span>
      </a>
    </li>
  </ul>
</div>

<div id="kvSidebarBackdrop" aria-hidden="true"></div>

<!-- ===== MODAL (solo NOTAS) ===== -->
<div class="modal fade kv-modal" id="modalNotas" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content kv-modal-content">
      <div class="kv-modalfx" aria-hidden="true"></div>
      <div class="modal-header kv-modal-header">
        <h5 class="modal-title">NOTAS</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body kv-modal-body"><p>Contenido NOTAS acá…</p></div>
    </div>
  </div>
</div>

<style>
  :root{
    --kv-header-h: 0px;
    --kv-header-z: 10000;

    /* ✅ GOLD TOKENS (más dorado real, menos marrón) */
    --kg-1:#fff2c6;
    --kg-2:#ffd77a;
    --kg-3:#f2b83f;
    --kg-4:#c98a12;

    --ink-1: rgba(10,10,12,.92);
    --ink-2: rgba(0,0,0,.96);

    --g-border: rgba(255,215,90,.32);
    --g-border2: rgba(255,215,90,.58);
    --g-glow: 0 0 18px rgba(255,215,90,.22);
  }

  .sidebar.kv-gold{
    width:260px;
    height:100vh;
    padding:10px 12px 12px;
    position:relative;
    overflow:hidden;
    transition: all .35s ease;
    background:
      radial-gradient(900px 520px at 18% 0%, rgba(255,200,80,.22), transparent 60%),
      radial-gradient(900px 520px at 90% 12%, rgba(212,175,55,.14), transparent 62%),
      linear-gradient(180deg, #0b0b0d 0%, #000 55%, #000 100%) !important;
    border-right:1px solid rgba(212,175,55,.22);
    box-shadow: 18px 0 55px rgba(0,0,0,.70);
    z-index: 9999;
  }

  .kv-goldfx{ position:absolute; inset:-120px; z-index:0; pointer-events:none; }
  .kv-goldfx::after{
    content:"";
    position:absolute; inset:0;
    background:
      radial-gradient(360px 260px at 18% 10%, rgba(255,215,90,.18), transparent 62%),
      radial-gradient(320px 260px at 80% 18%, rgba(255,255,255,.06), transparent 62%);
    opacity:.90;
    filter: blur(.15px);
    animation: kvGoldDrift 18s ease-in-out infinite;
  }
  @keyframes kvGoldDrift{
    0%{ transform: translate3d(-18px,-10px,0); }
    50%{ transform: translate3d(16px,10px,0); }
    100%{ transform: translate3d(-18px,-10px,0); }
  }

  .kv-goldfx::before{
    content:"";
    position:absolute; inset:0;
    background: linear-gradient(120deg, transparent 42%, rgba(255,215,90,.14) 50%, transparent 58%);
    transform: translateX(-140%);
    opacity:.85;
    animation: kvSheenSlow 6.8s linear infinite; /* ✅ MÁS LENTO */
  }
  @keyframes kvSheenSlow{
    0%{ transform: translateX(-140%); }
    100%{ transform: translateX(140%); }
  }

  .sidebar.kv-gold::before{
    content:"";
    position:absolute; inset:0;
    pointer-events:none;
    z-index:1;
    box-shadow:
      inset -1px 0 0 rgba(212,175,55,.32),
      inset 0 0 0 1px rgba(255,255,255,.02);
  }

  .sidebar-header{
    position:relative; z-index:2;
    min-height:0;
    margin:0 0 8px 0;
    padding:0 0 10px 0;
    display:flex; align-items:center; justify-content:space-between;
    border-bottom:1px solid rgba(212,175,55,.14);
  }

  .menu-hidden{
    opacity:0 !important;
    visibility:hidden !important;
    width:0 !important;
    height:0 !important;
    display:inline-block !important;
    overflow:hidden !important;
  }

  .sidebar-nav{
    position:relative; z-index:2;
    padding:0; margin:0; list-style:none;
    display:flex; flex-direction:column; width:100%;
  }

  .nav-item{ margin-bottom:.38rem; }

  /* =========================
     ✅ NAV BUTTONS: MÁS PRO
     Reflejo lento + glint lento (no spam)
     ========================= */
  .nav-link{
    width:100%;
    padding:12px 12px;
    border-radius:18px;
    display:flex; gap:12px; align-items:center;
    text-decoration:none;
    position:relative; overflow:hidden;

    background:
      radial-gradient(260px 130px at 18% 26%, rgba(255,215,90,.18), transparent 62%),
      linear-gradient(145deg, var(--ink-1), var(--ink-2));
    border:1px solid var(--g-border);
    box-shadow: 0 14px 32px rgba(0,0,0,.62);
    transition: transform .18s ease, filter .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  /* ✅ reflejo “pro” (doble capa suave) - MÁS LENTO */
  .nav-link::before{
    content:"";
    position:absolute; inset:-2px;
    pointer-events:none;
    background:
      linear-gradient(120deg,
        transparent 36%,
        rgba(255,255,255,.10) 46%,
        rgba(255,215,90,.15) 52%,
        transparent 64%
      ),
      linear-gradient(120deg,
        transparent 40%,
        rgba(255,215,90,.08) 50%,
        transparent 60%
      );
    transform: translateX(-140%);
    opacity:.82;
    animation: kvBtnSheen 7.6s linear infinite; /* ✅ MÁS LENTO */
  }
  @keyframes kvBtnSheen{
    0%{ transform: translateX(-140%); }
    100%{ transform: translateX(140%); }
  }

  /* ✅ destello dorado (glint) - MÁS LENTO y más elegante */
  .nav-link::after{
    content:"";
    position:absolute;
    left:-45%;
    top:-35%;
    width:30%;
    height:180%;
    pointer-events:none;
    background:
      radial-gradient(circle at 30% 50%, rgba(255,215,90,.55), rgba(255,215,90,0) 62%),
      linear-gradient(90deg, rgba(255,255,255,.10), rgba(255,215,90,.18), rgba(255,255,255,.06));
    filter: blur(.35px);
    opacity:0;
    transform: rotate(16deg);
    animation: kvBtnGlint 9.5s ease-in-out infinite; /* ✅ MÁS LENTO */
  }
  @keyframes kvBtnGlint{
    0%, 72%{ opacity:0; transform: translateX(0) rotate(16deg); }
    78%{ opacity:.90; }
    86%{ opacity:0; transform: translateX(520%) rotate(16deg); }
    100%{ opacity:0; }
  }

  .nav-link svg{
    width:18px; height:18px;
    stroke: rgba(255,215,90,.98);
    fill:none; stroke-width:2;
    filter: drop-shadow(0 0 10px rgba(255,215,90,.20));
    flex:0 0 auto;
  }

  .nav-link span{
    color: rgba(255,255,255,.96) !important;
    font-weight:950;
    letter-spacing:.10em;
    text-transform:uppercase;
    text-shadow: 0 0 12px rgba(255,215,90,.14);
    white-space:nowrap;
    overflow:hidden; text-overflow:ellipsis;
    flex: 1 1 auto; min-width: 0;
  }

  .nav-link:hover{
    transform: translateY(-2px);
    filter: brightness(1.08);
    border-color: var(--g-border2);
    box-shadow: 0 18px 46px rgba(0,0,0,.70);
  }

  .nav-link.active{
    background:
      radial-gradient(280px 140px at 18% 26%, rgba(255,255,255,.18), transparent 62%),
      linear-gradient(90deg, var(--kg-1), var(--kg-2), var(--kg-3), var(--kg-4)) !important;
    border:1px solid rgba(255,215,90,.58) !important;
    box-shadow: 0 18px 58px rgba(0,0,0,.55), var(--g-glow);
  }
  .nav-link.active svg{ stroke: #120a02 !important; filter:none; }
  .nav-link.active span{ color:#120a02 !important; text-shadow:none !important; }
  .nav-link.danger svg{ stroke: rgba(255,255,255,.90); }

  .nav-item.tools-item{ display:flex; flex-direction:column; }
  .tools-caret{ margin-left:auto; font-weight:950; transition: transform .2s ease; }
  .nav-item.tools-item.open .tools-caret{ transform:rotate(180deg); }

  .tools-panel{
    width:100%;
    display:grid;
    grid-template-rows:0fr;
    overflow:hidden;
    opacity:0;
    transform:translateY(-6px);
    transition:grid-template-rows .22s ease, opacity .18s ease, transform .18s ease, margin-top .22s ease;
    margin-top:0;
  }
  .nav-item.tools-item.open .tools-panel{
    grid-template-rows:1fr;
    opacity:1;
    transform:translateY(0);
    margin-top:.45rem;
  }

  .tools-card{
    position:relative;
    overflow:hidden;
    padding:10px;
    border-radius:16px;
    background:
      radial-gradient(300px 160px at 18% 0%, rgba(255,215,90,.18), transparent 60%),
      linear-gradient(145deg, rgba(10,10,12,.90), rgba(0,0,0,.95));
    border:1px solid rgba(255,215,90,.26);
    box-shadow:0 18px 55px rgba(0,0,0,.55);
  }

  .tools-grid{ position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr; gap:8px; }

  /* =========================
     ✅ TOOL BUTTONS: MÁS PRO
     Reflejo lento + glint lento
     ========================= */
  .tool-btn{
    border:none;
    border-radius:14px;
    padding:11px 8px;
    display:flex; align-items:center; justify-content:center; gap:8px;
    position:relative;
    overflow:hidden;

    background:
      radial-gradient(240px 110px at 18% 22%, rgba(255,215,90,.22), transparent 62%),
      linear-gradient(180deg, rgba(34,20,5,.90), rgba(0,0,0,.96));
    border:1px solid rgba(255,215,90,.40);

    color:rgba(255,255,255,.96);
    font-weight:950;
    letter-spacing:.12em;
    text-transform:uppercase;
    font-size:.70rem;
    box-shadow:0 14px 30px rgba(0,0,0,.50);
    transition: transform .16s ease, filter .16s ease, box-shadow .16s ease, border-color .16s ease;
    cursor:pointer;
  }

  /* reflejo tool - MÁS LENTO */
  .tool-btn::before{
    content:"";
    position:absolute; inset:-2px;
    pointer-events:none;
    background:
      linear-gradient(120deg,
        transparent 36%,
        rgba(255,255,255,.12) 46%,
        rgba(255,215,90,.18) 52%,
        transparent 64%
      ),
      linear-gradient(120deg,
        transparent 42%,
        rgba(255,215,90,.10) 50%,
        transparent 58%
      );
    transform: translateX(-140%);
    opacity:.88;
    animation: kvToolSheen 8.2s linear infinite; /* ✅ MÁS LENTO */
  }
  @keyframes kvToolSheen{
    0%{ transform: translateX(-140%); }
    100%{ transform: translateX(140%); }
  }

  /* destello tool - MÁS LENTO */
  .tool-btn::after{
    content:"";
    position:absolute;
    left:-50%;
    top:-40%;
    width:28%;
    height:190%;
    pointer-events:none;
    background:
      radial-gradient(circle at 30% 50%, rgba(255,215,90,.60), rgba(255,215,90,0) 62%),
      linear-gradient(90deg, rgba(255,255,255,.10), rgba(255,215,90,.20), rgba(255,255,255,.06));
    opacity:0;
    transform: rotate(14deg);
    animation: kvToolGlint 10.5s ease-in-out infinite; /* ✅ MÁS LENTO */
  }
  @keyframes kvToolGlint{
    0%, 74%{ opacity:0; transform: translateX(0) rotate(14deg); }
    80%{ opacity:.90; }
    88%{ opacity:0; transform: translateX(560%) rotate(14deg); }
    100%{ opacity:0; }
  }

  .tool-btn:hover{
    transform: translateY(-1px);
    filter: brightness(1.08);
    border-color: rgba(255,215,90,.60);
    box-shadow:0 18px 40px rgba(0,0,0,.65), var(--g-glow);
  }

  .tool-btn i{
    font-size:1rem;
    color: var(--kg-2);
    filter: drop-shadow(0 0 10px rgba(255,215,90,.22));
  }

  #kvSidebarBackdrop{
    position:fixed;
    left:0; right:0;
    top: var(--kv-header-h);
    height: calc(100vh - var(--kv-header-h));
    background: rgba(0,0,0,.60);
    backdrop-filter: blur(2px);
    opacity:0;
    visibility:hidden;
    transition: opacity .2s ease, visibility .2s ease;
    z-index: 9998;
  }
  #kvSidebarBackdrop.show{ opacity:1; visibility:visible; }
  body.kv-sidebar-open{ overflow:hidden; touch-action:none; }

  @media (max-width: 991px){
    .sidebar.kv-gold{
      margin-left:-260px;
      position:fixed;
      left:0;
      width:260px;
      top: var(--kv-header-h);
      height: calc(100vh - var(--kv-header-h));
    }
    .sidebar.kv-gold.active{ margin-left:0; }
  }

  .kv-modal .modal-dialog{ padding: 0 10px; }
  .kv-modal-content{
    position:relative;
    overflow:hidden;
    border-radius:18px;
    border:1px solid rgba(255,215,90,.34);
    background:
      radial-gradient(520px 240px at 18% 0%, rgba(255,215,90,.18), transparent 60%),
      linear-gradient(145deg, rgba(10,10,12,.92), rgba(0,0,0,.96));
    box-shadow: 0 30px 90px rgba(0,0,0,.65);
    color:#fff;
  }
  .kv-modalfx{
    position:absolute;
    inset:-2px;
    pointer-events:none;
    z-index:0;
    background: linear-gradient(120deg, transparent 42%, rgba(255,215,90,.18) 50%, transparent 58%);
    transform: translateX(-140%);
    opacity:.75;
    animation: kvModalSheen 10.8s linear infinite; /* ✅ un toque más lento */
  }
  @keyframes kvModalSheen{
    0%{ transform: translateX(-140%); }
    100%{ transform: translateX(140%); }
  }
  .kv-modal-header, .kv-modal-body{ position:relative; z-index:1; }

  @media (prefers-reduced-motion: reduce){
    .kv-goldfx::before, .kv-goldfx::after, .kv-modalfx,
    .nav-link::before, .nav-link::after,
    .tool-btn::before, .tool-btn::after{ animation:none !important; }
  }
</style>

<script>
(function () {
  const sidebar   = document.getElementById('sidebar');
  const backdrop  = document.getElementById('kvSidebarBackdrop');

  const toolsItem   = document.getElementById('toolsItem');
  const toolsToggle = document.getElementById('toolsToggle');
  const toolsPanel  = document.getElementById('toolsPanel');

  if (!sidebar) return;

  const isMobile = () => window.matchMedia('(max-width: 991px)').matches;

  // ✅ SOLO NOTAS abre modal
  const modalMap = { toolNotas: 'modalNotas' };

  function hardNeutralizeTargets(){
    sidebar.querySelectorAll('a').forEach(a=>{
      a.removeAttribute('target');
      a.removeAttribute('onclick');
    });
  }

  function findTopHeader(){
    const candidates = [
      document.getElementById('kingHeader'),
      document.querySelector('.header.king-header'),
      document.querySelector('.king-header'),
      document.querySelector('nav.king-header'),
      document.querySelector('nav.header'),
      document.querySelector('.app-header'),
      document.querySelector('.topbar'),
      document.querySelector('.navbar'),
      document.querySelector('header'),
      document.querySelector('nav')
    ].filter(Boolean);

    let best = null;
    let bestScore = -Infinity;

    candidates.forEach(el=>{
      const r = el.getBoundingClientRect();
      const cs = window.getComputedStyle(el);
      const pos = cs.position || '';
      const stickyOrFixed = (pos === 'sticky' || pos === 'fixed');
      const topish = Math.abs(r.top) < 40;
      const h = Math.max(0, r.height || 0);

      const score =
        (stickyOrFixed ? 1000 : 0) +
        (topish ? 200 : 0) +
        Math.min(140, h);

      if (h >= 30 && score > bestScore){
        bestScore = score;
        best = el;
      }
    });

    return best;
  }

  function syncHeaderMetrics(){
    if (!isMobile()){
      document.documentElement.style.setProperty('--kv-header-h', '0px');
      return;
    }

    const header = findTopHeader();
    let h = 0;
    let z = 10000;

    if (header){
      const r = header.getBoundingClientRect();
      h = Math.round(r.height || 0);

      const zRaw = window.getComputedStyle(header).zIndex;
      const zNum = Number.parseInt(zRaw, 10);
      z = Number.isFinite(zNum) ? zNum : 10000;

      if (!Number.isFinite(zNum)){
        header.style.zIndex = String(z);
        header.style.position = header.style.position || 'relative';
      }
    }

    document.documentElement.style.setProperty('--kv-header-h', (h > 0 ? h : 0) + 'px');
    document.documentElement.style.setProperty('--kv-header-z', String(z));

    const sidebarZ = Math.max(1, z - 1);
    const backdropZ = Math.max(1, z - 2);

    sidebar.style.zIndex = String(sidebarZ);
    if (backdrop) backdrop.style.zIndex = String(backdropZ);

    sidebar.style.top = (h > 0 ? h : 0) + 'px';
    sidebar.style.height = `calc(100vh - ${(h > 0 ? h : 0)}px)`;
    if (backdrop){
      backdrop.style.top = (h > 0 ? h : 0) + 'px';
      backdrop.style.height = `calc(100vh - ${(h > 0 ? h : 0)}px)`;
    }
  }

  function setBackdrop(on){
    if (!backdrop) return;
    backdrop.classList.toggle('show', !!on);
    document.body.classList.toggle('kv-sidebar-open', !!on);
  }

  function openSidebar(){
    if (!isMobile()) return;
    syncHeaderMetrics();
    sidebar.classList.add('active');
    setBackdrop(true);
  }

  function closeSidebar(){
    sidebar.classList.remove('active');
    setBackdrop(false);
  }

  if (backdrop) backdrop.addEventListener('click', closeSidebar);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSidebar(); });

  window.addEventListener('DOMContentLoaded', () => {
    closeSidebar();
    hardNeutralizeTargets();
    syncHeaderMetrics();
  });

  window.addEventListener('resize', syncHeaderMetrics);
  window.addEventListener('orientationchange', () => setTimeout(syncHeaderMetrics, 80));
  window.addEventListener('scroll', () => {
    if (sidebar.classList.contains('active')) syncHeaderMetrics();
  }, { passive:true });

  const mo = new MutationObserver(() => syncHeaderMetrics());
  mo.observe(document.documentElement, { childList:true, subtree:true, attributes:true });

  function openTools(){
    if (!toolsItem || !toolsPanel || !toolsToggle) return;
    toolsItem.classList.add('open');
    toolsPanel.setAttribute('aria-hidden','false');
    toolsToggle.setAttribute('aria-expanded','true');
  }
  function closeTools(){
    if (!toolsItem || !toolsPanel || !toolsToggle) return;
    toolsItem.classList.remove('open');
    toolsPanel.setAttribute('aria-hidden','true');
    toolsToggle.setAttribute('aria-expanded','false');
  }
  function toggleTools(){
    if (!toolsItem) return;
    toolsItem.classList.contains('open') ? closeTools() : openTools();
  }

  function showModal(modalId){
    const el = document.getElementById(modalId);
    if (!el || !window.bootstrap || !bootstrap.Modal) return;
    bootstrap.Modal.getOrCreateInstance(el, { backdrop:true, keyboard:true, focus:true }).show();
  }

  if (toolsToggle){
    toolsToggle.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      toggleTools();
    }, true);
  }

  // ✅ ACCESO -> HOME
  const accesoBtn = document.getElementById('toolAcceso');
  if (accesoBtn){
    accesoBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      if (isMobile()) closeSidebar();
      window.location.assign('/');
      return false;
    }, true);
  }

  // ✅ CDN -> /cdn
  const cdnBtn = document.getElementById('toolCdn');
  if (cdnBtn){
    cdnBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      if (isMobile()) closeSidebar();
      window.location.assign('/cdn');
      return false;
    }, true);
  }

  // ✅ PAYLOAD -> /payloads
  const payloadBtn = document.getElementById('toolPayload');
  if (payloadBtn){
    payloadBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      if (isMobile()) closeSidebar();
      window.location.assign('/payloads');
      return false;
    }, true);
  }

  // ✅ Modal: NOTAS
  Object.keys(modalMap).forEach(btnId => {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      showModal(modalMap[btnId]);
    }, true);
  });

  // ✅ Links sidebar: siempre misma pestaña
  document.addEventListener('click', function(ev){
    const a = ev.target && ev.target.closest ? ev.target.closest('#sidebar a.nav-link') : null;
    if (!a) return;
    if (a.id === 'toolsToggle') return;

    const href = a.getAttribute('href') || '';
    if (href && href !== '#'){
      ev.preventDefault();
      ev.stopPropagation();
      ev.stopImmediatePropagation();

      a.removeAttribute('target');
      a.removeAttribute('onclick');

      if (isMobile()) closeSidebar();
      window.location.assign(href);
      return false;
    }
  }, true);

  // ✅ Cuando abre un modal: cerrar sidebar
  document.addEventListener('show.bs.modal', () => { closeSidebar(); }, true);

  // ✅ Botón del header (hamburguesa) si existe
  const openBtn = document.getElementById('openNav');
  if (openBtn){
    openBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      sidebar.classList.contains('active') ? closeSidebar() : openSidebar();
    }, true);
  }

})();
</script>

