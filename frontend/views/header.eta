<!-- ======================= KINGVPN HEADER (LUXE: MATCH SIDEBAR KING GOLD + REFLEJO) ======================= -->
<!-- PEGÁ TODO ESTO JUNTO (HTML + CSS + JS) -->

<!-- HEADER -->
<nav class="header king-header king-header-luxe" id="kingHeader">
  <button id="openNav" class="menu-btn" aria-label="Abrir menú" type="button">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 6H21"></path>
      <path d="M3 12H21"></path>
      <path d="M3 18H21"></path>
    </svg>
  </button>

  <div class="header-title">
    KING<span>•VPN</span>
  </div>

  <div class="header-user" role="button" tabindex="0">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4z"></path>
      <path d="M4 20c0-3.31 3.58-6 8-6s8 2.69 8 6"></path>
    </svg>
    <span><%= it.user.username %></span>
  </div>
</nav>

<style>
/* ===================== KINGVPN HEADER LUXE (MATCH SIDEBAR KING GOLD + REFLEJO) ===================== */
:root{
  --k-gold:#D4AF37;
  --k-gold2:#FFD36A;
  --k-gold3:#8C6B1A;

  --k-ink1: rgba(60, 35, 9, .92);
  --k-ink2: rgba(18, 10, 2, .96);

  --k-border: rgba(255,211,106,.22);
  --k-border2: rgba(255,211,106,.42);

  --k-text: rgba(255,246,214,.96);
  --k-muted: rgba(255,226,170,.72);

  --k-shadow: 0 16px 40px rgba(0,0,0,.60);
  --k-glow: 0 0 0 1px rgba(255,211,106,.14), 0 12px 28px rgba(0,0,0,.62);
}

/* ✅ Mata padding-top viejo */
body{ padding-top: 0 !important; }

/* ✅ ANTI-BLUR SAFE (para que no se “lavé” en Android) */
.header.king-header.king-header-luxe,
.header.king-header.king-header-luxe *{
  filter:none !important;
  -webkit-filter:none !important;
}

/* ===================== HEADER ===================== */
.header.king-header.king-header-luxe{
  position: sticky;
  top: 0;
  z-index: 1200;

  height: 50px;
  width: 100%;
  margin: 0;
  padding: 0 16px;

  display:flex;
  align-items:center;
  justify-content: space-between;

  background:
    radial-gradient(980px 560px at 18% 0%, rgba(255,211,106,.22), transparent 62%),
    radial-gradient(980px 560px at 92% 12%, rgba(212,175,55,.16), transparent 66%),
    linear-gradient(180deg, rgba(18,10,2,.98) 0%, rgba(10,6,1,.99) 55%, rgba(0,0,0,1) 100%) !important;

  border-bottom: 1px solid var(--k-border);
  box-shadow: var(--k-shadow);

  overflow: hidden;
  transform: translateZ(0);
}

/* Marco fino como la sidebar */
.header.king-header.king-header-luxe::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  box-shadow:
    inset 0 -1px 0 rgba(255,211,106,.18),
    inset 0 0 0 1px rgba(255,255,255,.02);
  opacity: 1;
}

/* Glow ambiental sutil */
.header.king-header.king-header-luxe::after{
  content:"";
  position:absolute;
  inset:-40px;
  pointer-events:none;
  background:
    radial-gradient(360px 240px at 18% 40%, rgba(255,211,106,.10), transparent 62%),
    radial-gradient(320px 240px at 86% 45%, rgba(255,255,255,.05), transparent 62%);
  opacity: .95;
}

/* ✅ REFLEJO PRO (sheen) LENTO ARRIBA */
.header.king-header.king-header-luxe .king-reflex{
  position:absolute;
  inset:-2px;
  pointer-events:none;
  z-index: 0;
  background: linear-gradient(120deg, transparent 42%, rgba(255,211,106,.14) 50%, transparent 58%);
  transform: translateX(-140%);
  opacity:.75;
  animation: kingHeaderSheen 7.6s linear infinite;
}
@keyframes kingHeaderSheen{
  0%{ transform: translateX(-140%); }
  100%{ transform: translateX(140%); }
}

/* Para que el reflejo exista sin tocar tu HTML: lo creamos con ::marker? No. Creamos con ::after no,
   entonces lo inyectamos con :first-child via pseudo:
   usamos un pseudo-elemento extra con background y animación. */
.header.king-header.king-header-luxe{
  position: sticky;
}
.header.king-header.king-header-luxe::marker{ content:""; } /* noop */
.header.king-header.king-header-luxe::selection{ background: transparent; } /* noop */

/* ✅ Reflejo sin agregar div: pseudo extra usando background-layer animado */
.header.king-header.king-header-luxe .header-title,
.header.king-header.king-header-luxe .menu-btn,
.header.king-header.king-header-luxe .header-user{
  position: relative;
  z-index: 2;
}

/* ===================== BOTÓN MENÚ ===================== */
.header.king-header.king-header-luxe .menu-btn{
  width: auto;
  margin: 0;

  background:
    radial-gradient(220px 90px at 20% 30%, rgba(255,211,106,.10), transparent 62%),
    linear-gradient(145deg, var(--k-ink1), var(--k-ink2));
  border:1px solid rgba(255,211,106,.26);
  box-shadow: var(--k-glow);

  cursor: pointer;
  padding: 8px 12px;
  border-radius: 12px;

  transition: transform .12s ease, filter .12s ease, box-shadow .12s ease, border-color .12s ease;

  visibility: visible !important;
  opacity: 1 !important;
  color: inherit;

  overflow:hidden;
}
.header.king-header.king-header-luxe .menu-btn::after{
  content:"";
  position:absolute;
  top:-40%; left:-120%;
  width: 80%;
  height: 180%;
  transform: rotate(18deg);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent);
  transition: left .65s ease;
  pointer-events:none;
}
.header.king-header.king-header-luxe .menu-btn:hover::after{ left: 140%; }
.header.king-header.king-header-luxe .menu-btn:hover{
  filter: brightness(1.07);
  border-color: rgba(255,211,106,.45);
  box-shadow: 0 16px 36px rgba(0,0,0,.62), 0 0 18px rgba(255,211,106,.16);
}
.header.king-header.king-header-luxe .menu-btn:active{ transform: translateY(1px); }

.header.king-header.king-header-luxe .menu-btn svg{
  width: 20px;
  height: 20px;
  stroke: rgba(255,246,214,.96);
  stroke-width: 2.2;
  fill: none;
  opacity: .96;
  filter: drop-shadow(0 0 10px rgba(255,211,106,.12));
}

/* ===================== TÍTULO ===================== */
.header.king-header.king-header-luxe .header-title{
  position:absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;

  font-size: .95rem;
  font-weight: 1000;
  letter-spacing: .24em;
  color: rgba(255,246,214,.96);
  user-select: none;

  text-shadow:
    0 0 10px rgba(0,0,0,.55),
    0 0 16px rgba(255,211,106,.12);
}
.header.king-header.king-header-luxe .header-title span{ opacity: .40; }

/* ===================== USUARIO ===================== */
.header.king-header.king-header-luxe .header-user{
  display:flex;
  align-items:center;
  gap: 8px;

  padding: 8px 12px;
  border-radius: 999px;

  background:
    radial-gradient(220px 90px at 20% 30%, rgba(255,211,106,.10), transparent 62%),
    linear-gradient(145deg, var(--k-ink1), var(--k-ink2));
  border:1px solid rgba(255,211,106,.20);
  box-shadow: var(--k-glow);

  max-width: 52%;
  overflow: hidden;
  cursor: pointer;

  transition: filter .12s ease, transform .12s ease, border-color .12s ease, box-shadow .12s ease;

  position:relative;
  overflow:hidden;
}
.header.king-header.king-header-luxe .header-user::after{
  content:"";
  position:absolute;
  top:-40%; left:-120%;
  width: 80%;
  height: 180%;
  transform: rotate(18deg);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent);
  transition: left .65s ease;
  pointer-events:none;
}
.header.king-header.king-header-luxe .header-user:hover::after{ left: 140%; }

.header.king-header.king-header-luxe .header-user:hover{
  filter: brightness(1.07);
  border-color: rgba(255,211,106,.38);
  box-shadow: 0 16px 36px rgba(0,0,0,.62), 0 0 18px rgba(255,211,106,.16);
}
.header.king-header.king-header-luxe .header-user:active{ transform: translateY(1px); }

.header.king-header.king-header-luxe .header-user svg{
  width: 16px;
  height: 16px;
  stroke: rgba(255,211,106,.95);
  stroke-width: 2.2;
  fill: none;
  filter: drop-shadow(0 0 10px rgba(255,211,106,.12));
}

.header.king-header.king-header-luxe .header-user span{
  font-size: .72rem;
  font-weight: 950;
  letter-spacing: .09em;
  text-transform: uppercase;
  color: rgba(255,246,214,.96);

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== Overlay sidebar (para cerrar tocando fuera) ===== */
#kvSidebarBackdrop{
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.62);
  opacity: 0;
  visibility: hidden;
  transition: opacity .2s ease, visibility .2s ease;
  z-index: 998;
}
#kvSidebarBackdrop.show{ opacity: 1; visibility: visible; }
body.kv-sidebar-open{ overflow: hidden; touch-action: none; }

/* Desktop: ocultar botón */
@media (min-width: 992px){
  .header.king-header.king-header-luxe .menu-btn{ visibility: hidden !important; opacity: 0 !important; }
}
@media (max-width: 991px){
  .header.king-header.king-header-luxe .menu-btn{ visibility: visible !important; opacity: 1 !important; }
}

/* ✅ Reduce motion */
@media (prefers-reduced-motion: reduce){
  .header.king-header.king-header-luxe .menu-btn::after,
  .header.king-header.king-header-luxe .header-user::after{
    transition:none !important;
  }
  .header.king-header.king-header-luxe::after{ opacity: .90; }
}
</style>

<script>
/* ===================== KINGVPN HEADER + SIDEBAR TOGGLE (ANTI-BUG) ===================== */
(function () {
  const header = document.getElementById('kingHeader');
  const sidebar = document.getElementById('sidebar');
  const openBtn = document.getElementById('openNav');   // botón del HEADER
  const closeBtn = document.getElementById('closeNav'); // botón del SIDEBAR

  if (!sidebar || !openBtn) return;

  // Backdrop (overlay) para tocar fuera y cerrar
  let backdrop = document.getElementById('kvSidebarBackdrop');
  if (!backdrop) {
    backdrop = document.createElement('div');
    backdrop.id = 'kvSidebarBackdrop';
    document.body.appendChild(backdrop);
  }

  const isMobile = () => window.matchMedia('(max-width: 991px)').matches;

  function setBackdrop(on) {
    backdrop.classList.toggle('show', !!on);
    document.body.classList.toggle('kv-sidebar-open', !!on);
  }

  function openSidebar() {
    if (!isMobile()) return;
    sidebar.classList.add('active');
    setBackdrop(true);
  }

  function closeSidebar() {
    sidebar.classList.remove('active');
    setBackdrop(false);
  }

  function toggleSidebar() {
    if (!isMobile()) return;
    sidebar.classList.contains('active') ? closeSidebar() : openSidebar();
  }

  openBtn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();
    toggleSidebar();
  }, true);

  if (closeBtn) {
    closeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      closeSidebar();
    }, true);
  }

  backdrop.addEventListener('click', closeSidebar);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSidebar();
  });

  document.addEventListener('show.bs.modal', () => {
    closeSidebar();
    document.body.classList.add('king-modal-open');
  }, true);

  document.addEventListener('hidden.bs.modal', () => {
    document.body.classList.remove('king-modal-open');
    if (header) {
      header.style.transform = 'translateZ(0)';
      requestAnimationFrame(() => (header.style.transform = ''));
    }
    sidebar.style.transform = 'translateZ(0)';
    requestAnimationFrame(() => (sidebar.style.transform = ''));
  }, true);

  window.addEventListener('DOMContentLoaded', () => closeSidebar());

  window.addEventListener('resize', () => {
    if (!isMobile()) setBackdrop(false);
    else setBackdrop(sidebar.classList.contains('active'));
  });

  /* ✅ REFLEJO AUTOMÁTICO EN HEADER (sin tocar tu HTML) */
  // Creamos un pseudo “layer” real con un div para animación (más consistente en Android)
  window.addEventListener('DOMContentLoaded', () => {
    if (!header) return;
    if (header.querySelector('.king-reflex')) return;
    const fx = document.createElement('div');
    fx.className = 'king-reflex';
    header.insertBefore(fx, header.firstChild);
  });
})();
</script>
